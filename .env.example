# Copy this file to .env and fill in your own values.
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789
ADMIN_USERNAME=admin_username

# Group links. The values below are placeholders (default state).
# Until you replace them, the bot will not post members' introductions to the group.
# Invite link of the group, sent to users who press "عضویت در گروه"
GROUP_INVITE_LINK=https://t.me/your_group
# Link of the "member introductions" topic (copy the link of any message inside that topic)
INTRO_TOPIC_LINK=https://t.me/your_group/2
# Link of the "networking" topic
NETWORKING_TOPIC_LINK=https://t.me/your_group/3

# Optional: path of the welcome voice file (default: voice/welcome.ogg)
# VOICE_PATH=voice/welcome.ogg
